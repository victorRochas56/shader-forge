{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Build Release",
            "type": "shell",
            "command": "cmake --build build --config Release",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"],
            "dependsOn": ["CMake Configure"]
        },
        {
            "label": "CMake Build Debug",
            "type": "shell",
            "command": "cmake --build build --config Debug",
            "group": "build",
            "problemMatcher": ["$msCompile"],
            "dependsOn": ["CMake Configure"]
        },
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "build",
                "-DCMAKE_TOOLCHAIN_FILE=C:/Users/vicro/Desktop/dev/my/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "-DSLANGC_EXECUTABLE=C:/VulkanSDK/1.4.341.1/Bin/slangc.exe",
                "-DVULKAN_INCLUDE_DIR=C:/VulkanSDK/1.4.341.1/Include"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}